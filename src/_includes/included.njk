{#- What's in and out of the price, on every trip page. Expects `trip`. -#}
      <h2 class="reveal">What’s included</h2>
      <div class="included reveal">
        <div class="included-col">
          <h3>In the price</h3>
          <ul class="tick-list">
            {%- for line in trip.included %}
            <li>{{ line }}</li>
            {%- endfor %}
          </ul>
        </div>
        <div class="included-col">
          <h3>Not in the price</h3>
          <ul class="tick-list cross-list">
            {%- for line in trip.not_included %}
            <li>{{ line }}</li>
            {%- endfor %}
          </ul>
        </div>
      </div>
